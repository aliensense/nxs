{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aliensense.github.io/nxs-docs/schemas/pack.schema.json",
  "title": "NXS camera descriptor pack manifest (pack.yaml)",
  "description": "The pack's index. A base pack names its chip descriptors, the flows module and the deserializers it serves, the default topology, and the golden references its composer is diffed against. An extension names the base pack it extends and the sensor descriptors it adds.",
  "type": "object",
  "oneOf": [
    {
      "title": "base pack",
      "additionalProperties": false,
      "required": [
        "pack",
        "api",
        "chips",
        "flows",
        "flows_for"
      ],
      "properties": {
        "pack": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_\\-]*$"
        },
        "api": {
          "$ref": "#/$defs/api"
        },
        "chips": {
          "$ref": "#/$defs/chips"
        },
        "flows": {
          "type": "string",
          "description": "The flow-assembly module (a .py file) or package (a directory with __init__.py), relative to the pack."
        },
        "flows_for": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9_\\-]+,[a-z0-9_\\-]+$"
          }
        },
        "topology": {
          "type": "string",
          "pattern": "\\.ya?ml$"
        },
        "golden": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "flow",
            "files"
          ],
          "properties": {
            "flow": {
              "type": "string"
            },
            "files": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    {
      "title": "extension",
      "additionalProperties": false,
      "required": [
        "extends",
        "api",
        "chips"
      ],
      "properties": {
        "extends": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_\\-]*$"
        },
        "api": {
          "$ref": "#/$defs/api"
        },
        "chips": {
          "$ref": "#/$defs/chips"
        }
      }
    }
  ],
  "$defs": {
    "api": {
      "type": "integer",
      "enum": [
        1
      ],
      "description": "The descriptor pack API this SDK speaks; the loader refuses any other by name."
    },
    "chips": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]*$"
      }
    }
  }
}
