              "fps_ceiling": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "sensor_mode": {
                "type": [
                  "integer",
                  "null"
                ],
                "description": "The mode's index in the table the port boots; null for a mode the table carries no row for, or on a hub without a capture table."
              },
              "token": {
                "type": "string",
                "description": "The mode as `on --mode` takes it: WxH, or WxH-rawN when two depths share a geometry."
              },
              "runs_alone": {
                "type": "boolean",
                "description": "On a pair, true for a mode the pair's program does not carry: it runs one camera alone on the port, with no range, line or sync pair listed here."
              },
              "capture_row": {
                "type": [
                  "boolean",
                  "null"
                ],
                "description": "Whether the table the port boots carries the mode's row (one pixel format per table); false for a mode that boots on no node, with no range or line listed; null on a hub without a capture table."
              },
              "fps_floor": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "fps_guaranteed": {
                "type": [
                  "number",
                  "null"
                ],
                "description": "The rate at which the mode runs the datasheet's recommended frame at the port's line; a slower rate stretches the frame past it, where the datasheet guarantees no imaging characteristics. Null for a part whose table sets its frame, or a mode the port does not run."
              },
              "line_time_ns": {
                "type": [
                  "integer",
                  "null"
                ],
                "description": "The line period the mode runs in this port, in nanoseconds."
              },
              "line_source": {
                "type": [
                  "string",
                  "null"
                ],
                "enum": [
                  "datasheet",
                  "found",
                  null
                ],
                "description": "Where the line comes from: the datasheet (the sensor's own line, or the deserializer's pair line law on a pair), or found (the longer line the delivery check of `on` found a pair needs on this rig); null for a mode without a line."
              },
              "offered": {
                "type": "boolean",
                "description": "True when the unit program carries the mode; false for a mode served by a bench capture alone."
              }
            }
          }
        },
        "knobs": {
