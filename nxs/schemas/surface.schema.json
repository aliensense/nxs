{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aliensense.github.io/nxs-docs/schemas/surface.schema.json",
  "title": "nxs --json surfaces (contract 2)",
  "description": "Every document an `nxs … --json` verb emits, one definition per surface. Each carries `contract: 2`; a breaking change to any surface bumps the contract.",
  "$defs": {
    "contract": {
      "const": 2
    },
    "field": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "value",
        "options"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "value": {
          "type": [
            "string",
            "number",
            "boolean"
          ]
        },
        "options": {
          "type": "array",
          "items": {
            "type": [
              "string",
              "number",
              "boolean"
            ]
          }
        },
        "labels": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "unit": {
          "type": "string"
        }
      }
    },
    "stream": {
      "title": "nxs stream --count N --json",
      "description": "A finite, decoded read of a unit: the fields with their units, then --count samples in SI. What nxs mcp serves as samples.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract",
        "personality",
        "fields",
        "samples"
      ],
      "properties": {
        "contract": {
          "$ref": "#/$defs/contract"
        },
        "personality": {
          "type": "string"
        },
        "fields": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "unit": {
                "type": "string"
              }
            }
          }
        },
        "samples": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "n",
              "values"
            ],
            "properties": {
              "n": {
                "type": "integer"
              },
              "ts_us": {
                "type": [
                  "integer",
                  "null"
                ]
              },
              "values": {
                "type": "object"
              }
            }
          }
        },
        "rate_hz": {
          "type": "number"
        }
      }
    },
    "tune": {
      "title": "nxs tune --list/--set/--play --json",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract",
        "manifest",
        "channels"
      ],
      "properties": {
        "contract": {
          "$ref": "#/$defs/contract"
        },
        "manifest": {
          "type": "string"
        },
        "channels": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "kind",
              "declared",
              "presence",
              "sections"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "kind": {
                "enum": [
                  "port",
                  "link",
                  "unit"
                ]
              },
              "declared": {
                "type": "boolean",
                "description": "False for a node the platform carries or that answered, with no manifest entry yet; its DECLARE knobs write one."
              },
              "presence": {
                "enum": [
                  "present",
                  "absent",
                  "unknown"
                ]
              },
              "note": {
                "type": "string"
              },
              "sections": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "label",
                    "kind",
                    "fields"
                  ],
                  "properties": {
                    "label": {
                      "type": "string"
                    },
                    "kind": {
                      "enum": [
                        "declare",
                        "camera",
                        "sync",
                        "gain",
                        "sensor",
                        "mount",
                        "egress",
                        "firmware"
                      ]
                    },
                    "unit": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "fields": {
                      "type": "array",
                      "items": {
                        "$ref": "#/$defs/field"
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "applied": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "channel",
              "section",
              "field",
              "value"
            ],
            "properties": {
              "channel": {
                "type": "string"
              },
              "section": {
                "type": "string"
              },
              "field": {
                "type": "string"
              },
              "value": {
                "type": [
                  "string",
                  "number",
                  "boolean"
                ]
              }
            }
          }
        },
        "backup": {
          "type": "string"
        },
        "findings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/finding"
          }
        },
        "played": {
          "type": "boolean"
        }
      }
    },
    "scan": {
      "title": "nxs probe --json (bare: config-free discovery)",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract",
        "buses",
        "not_opened"
      ],
      "properties": {
        "contract": {
          "$ref": "#/$defs/contract"
        },
        "buses": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "bus",
              "hubs",
              "units",
              "sensors"
            ],
            "properties": {
              "bus": {
                "type": "string"
              },
              "hubs": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "addr",
                    "kind"
                  ],
                  "properties": {
                    "addr": {
                      "type": "integer"
                    },
                    "kind": {
                      "type": "string"
                    }
                  }
                }
              },
              "units": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "addr",
                    "serial"
                  ],
                  "properties": {
                    "addr": {
                      "type": "integer"
                    },
                    "serial": {
                      "type": "string"
                    }
                  }
                }
              },
              "sensors": {
                "type": "array",
                "items": {
                  "type": "integer"
                }
              }
            }
          }
        },
        "not_opened": {
          "description": "The leaf buses the sweep could not open, so did not sweep, each with the reason (`Permission denied` names the i2c group the user lacks).",
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "bus",
              "reason"
            ],
            "properties": {
              "bus": {
                "type": "string"
              },
              "reason": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "ack": {
      "enum": [
        "present",
        "no ACK"
      ]
    },
    "link_ack": {
      "description": "A link's serializer or head as the walk found it: present, silent, or not read because the hub reports the link unlocked or did not answer its lock probe.",
      "enum": [
        "present",
        "no ACK",
        "link not locked",
        "link lock not read"
      ]
    },
    "presence": {
      "title": "the presence walk of a port (nxs <port> status --json, presence)",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract",
        "port",
        "bus",
        "ok",
        "walked",
        "links"
      ],
      "properties": {
        "contract": {
          "$ref": "#/$defs/contract"
        },
        "error": {
          "type": "string",
          "description": "Why the probe stopped before the walk: the bus could not be opened or locked, or the hub cannot be identified."
        },
        "held": {
          "type": "boolean",
          "description": "Another nxs run held the bus lock past the wait (nxsd while it brings the ports up after boot): status stopped its remaining reads, what the walk read before stands, and a hub it did not reach is not absent."
        },
        "port": {
          "type": "string"
        },
        "bus": {
          "type": "string"
        },
        "ok": {
          "type": "boolean"
        },
        "hub": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "present"
          ],
          "properties": {
            "present": {
              "type": "boolean"
            },
            "id": {
              "type": [
                "integer",
                "null"
              ]
            },
            "verified": {
              "type": [
                "boolean",
                "null"
              ]
            }
          }
        },
        "walked": {
          "type": "boolean"
        },
        "links": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "sen",
              "units"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "ser": {
                "$ref": "#/$defs/link_ack"
              },
              "sen": {
                "$ref": "#/$defs/link_ack"
              },
              "sen_addr": {
                "description": "The address the head was probed at: its host alias while the port is up, its own address before the first on maps it.",
                "type": "integer"
              },
              "mapped": {
                "description": "True when the head answered at its host alias (the port is up).",
                "type": "boolean"
              },
              "units": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "addr",
                    "state"
                  ],
                  "properties": {
                    "addr": {
                      "type": "integer"
                    },
                    "state": {
                      "$ref": "#/$defs/ack"
                    },
                    "strap": {
                      "type": "integer",
                      "description": "The address the pod straps, sought when its alias is silent."
                    },
                    "answers_at": {
                      "type": "integer",
                      "description": "Where a pod silent at its alias answered: the hub lost its aliases, and `nxs switch` maps them."
                    },
                    "personalities": {
                      "type": "array",
                      "description": "The personalities the unit holds, read after the walk, every one the same shape: the one it measures with (`sensor`) and the one a camera run executes (`camera`, with its slot, compatible, mode values and last run). A kind the unit does not hold is not listed.",
                      "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "kind",
                          "name",
                          "text"
                        ],
                        "properties": {
                          "kind": {
                            "enum": ["click", "cam"]
                          },
                          "text": {
                            "type": "string"
                          },
                          "name": {
                            "type": "string"
                          },
                          "slot": {
                            "type": "integer"
                          },
                          "compatible": {
                            "type": "string"
                          },
                          "modes": {
                            "type": "object",
                            "additionalProperties": {
                              "type": "integer"
                            }
                          },
                          "run": {
                            "type": "object",
                            "additionalProperties": false,
                            "required": [
                              "state",
                              "error",
                              "values"
                            ],
                            "properties": {
                              "state": {
                                "type": "string"
                              },
                              "error": {
                                "type": "integer"
                              },
                              "values": {
                                "type": "object",
                                "additionalProperties": {
                                  "type": "integer"
                                }
                              }
                            }
                          }
                        }
                      }
                    },
                    "error": {
                      "type": "string"
                    }
                  }
                }
              },
              "sensor": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "declared",
                  "detected",
                  "detail",
                  "ok",
                  "text"
                ],
                "properties": {
                  "declared": {
                    "type": "string"
                  },
                  "detected": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "detail": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "ok": {
                    "type": "boolean"
                  },
                  "text": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "csi_lanes": {
          "type": "integer"
        },
        "dt_lanes": {
          "type": [
            "integer",
            "null"
          ]
        }
      }
    },
    "status": {
      "title": "nxs <port> status --json",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract",
        "port",
        "bus",
        "sync",
        "ok",
        "sections"
      ],
      "properties": {
        "contract": {
          "$ref": "#/$defs/contract"
        },
        "port": {
          "type": "string"
        },
        "bus": {
          "type": "string"
        },
        "sync": {
          "type": "string"
        },
        "ok": {
          "type": "boolean"
        },
        "sections": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "title",
              "results",
              "derived"
            ],
            "properties": {
              "title": {
                "type": "string"
              },
              "results": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "name",
                    "text",
                    "raw",
                    "ok"
                  ],
                  "properties": {
                    "name": {
                      "type": "string"
                    },
                    "text": {
                      "type": "string"
                    },
                    "raw": {
                      "type": [
                        "integer",
                        "null"
                      ]
                    },
                    "ok": {
                      "type": [
                        "boolean",
                        "null"
                      ]
                    },
                    "desc": {
                      "type": "string"
                    }
                  }
                }
              },
              "derived": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        },
        "verdict": {
          "description": "Declared against actual: one line for the port and one per declared link; ok when every declared link is up on a ready capture stack.",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "ok",
            "lines"
          ],
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "lines": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "sync_live": {
          "description": "The live synced pair recorded by the last up/trigger (null when no port state is recorded).",
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": false,
          "properties": {
            "source": {
              "enum": [
                "free_run",
                "fsync"
              ]
            },
            "fps": {
              "type": [
                "number",
                "null"
              ]
            },
            "links": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              },
              "description": "What each link does under the trigger (fsync, or free_run with the reason)."
            },
            "pulse_exposure": {
              "type": "boolean",
              "description": "The trigger pulse sets the synced links' exposure: the pulse's low time at one pulse per frame plus the sensor's trigger offset (absent when it sets none)."
            },
            "trigger_vmax": {
              "type": "object",
              "additionalProperties": {
                "type": "integer"
              },
              "description": "The trigger frame each synced link runs, in lines."
            },
            "ae": {
              "description": "Who sets the exposure and the gain of the port's camera links: under frame sync the leader's capture session decides the pair's gain and the follower's head takes it (follow), a declared gain locks every named link (locked), or each capture session runs its own loop (per_link, with the reason).",
              "oneOf": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "mode",
                    "leader",
                    "follower"
                  ],
                  "properties": {
                    "mode": {
                      "const": "follow"
                    },
                    "leader": {
                      "type": "string"
                    },
                    "follower": {
                      "type": "string"
                    }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "mode",
                    "gain_db",
                    "links"
                  ],
                  "properties": {
                    "mode": {
                      "const": "locked"
                    },
                    "gain_db": {
                      "type": "number",
                      "minimum": 0
                    },
                    "links": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      },
                      "minItems": 1
                    }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "mode",
                    "reason"
                  ],
                  "properties": {
                    "mode": {
                      "const": "per_link"
                    },
                    "reason": {
                      "type": "string"
                    }
                  }
                }
              ]
            }
          },
          "required": [
            "source"
          ]
        },
        "verified": {
          "description": "The delivery check that last passed on the port, after `on`, `set sync` or `set fps` (null when none holds: a new boot, a sync or rate change, a link marked unknown or parked clears it).",
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": false,
          "required": [
            "at",
            "rates"
          ],
          "properties": {
            "at": {
              "type": "number",
              "description": "When the check ran, in seconds since the epoch."
            },
            "rates": {
              "type": "object",
              "additionalProperties": {
                "type": "number"
              },
              "description": "The rate each link delivered, in fps, by the buffers' timestamps."
            }
          }
        },
        "ae": {
          "description": "Who decides the gain of the port's camera links: the part the record names (sync_live.ae), and for a followed pair whether nxsd copies the leader's gain now (following: the follower's heartbeat says so and is at most 3 s old), the heartbeat's age in seconds, the gain it copies and the reason a follower its faults stopped gives (null when the record names no part).",
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "mode",
                "leader",
                "follower",
                "gain_db",
                "following",
                "heartbeat_age_s"
              ],
              "properties": {
                "mode": {
                  "const": "follow"
                },
                "leader": {
                  "type": "string"
                },
                "follower": {
                  "type": "string"
                },
                "gain_db": {
                  "type": [
                    "number",
                    "null"
                  ],
                  "minimum": 0
                },
                "following": {
                  "type": "boolean"
                },
                "heartbeat_age_s": {
                  "type": [
                    "number",
                    "null"
                  ],
                  "minimum": 0
                },
                "reason": {
                  "type": "string"
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "mode",
                "gain_db",
                "links",
                "following",
                "heartbeat_age_s"
              ],
              "properties": {
                "mode": {
                  "const": "locked"
                },
                "gain_db": {
                  "type": "number",
                  "minimum": 0
                },
                "links": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "minItems": 1
                },
                "following": {
                  "const": false
                },
                "heartbeat_age_s": {
                  "type": "null"
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "mode",
                "reason",
                "following",
                "heartbeat_age_s"
              ],
              "properties": {
                "mode": {
                  "const": "per_link"
                },
                "reason": {
                  "type": "string"
                },
                "following": {
                  "const": false
                },
                "heartbeat_age_s": {
                  "type": "null"
                }
              }
            }
          ]
        },
        "presence": {
          "description": "The presence walk the status began with: the hub, each link's chain and unit.",
          "$ref": "#/$defs/presence"
        }
      }
    },
    "tree": {
      "title": "nxs status --json (bare: the declaration against the rig)",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract",
        "manifest",
        "ok",
        "declaration",
        "ports",
        "units"
      ],
      "properties": {
        "contract": {
          "$ref": "#/$defs/contract"
        },
        "manifest": {
          "type": "string"
        },
        "ok": {
          "type": "boolean"
        },
        "declaration": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "in_tune",
            "findings",
            "unplaced"
          ],
          "properties": {
            "in_tune": {
              "type": "boolean"
            },
            "findings": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/finding"
              }
            },
            "unplaced": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/finding"
              }
            }
          }
        },
        "personalities": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "dir",
            "shipped",
            "installed"
          ],
          "properties": {
            "dir": {
              "type": "string"
            },
            "shipped": {
              "type": "integer",
              "description": "The sealed personalities the assets put in the store."
            },
            "installed": {
              "type": "integer",
              "description": "The personalities installed beside them (nxs personality install)."
            }
          }
        },
        "ports": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "bus",
              "findings"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "bus": {
                "type": "string"
              },
              "hub": {
                "type": "string"
              },
              "driver": {
                "type": "string"
              },
              "findings": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/finding"
                }
              },
              "presence": {
                "$ref": "#/$defs/presence"
              },
              "error": {
                "type": "string"
              }
            }
          }
        },
        "units": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "routes",
              "ok",
              "findings"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "routes": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "ok": {
                "type": "boolean"
              },
              "findings": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/finding"
                }
              },
              "route": {
                "type": "string"
              },
              "serial": {
                "type": "string"
              },
              "fw": {
                "type": "string"
              },
              "personality": {
                "type": "string"
              },
              "vm": {
