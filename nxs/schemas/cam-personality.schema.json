{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aliensense.github.io/nxs-docs/schemas/cam-personality.schema.json",
  "title": "NXS chip facts (<chip>.yaml)",
  "description": "One chip's facts, a cam personality's head or a hub's deserializer or serializer: identity, registers, modes (sensors), windows, outputs and pipes (deserializers), limits, and the declarative status probes. The laws and knobs come from the law family meta.chip names, or from a paired physics module; this schema pins the shape the loader reads.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "meta",
    "registers"
  ],
  "properties": {
    "default_mode": {
      "type": "string"
    },
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "compatible",
        "role"
      ],
      "properties": {
        "compatible": {
          "type": "string",
          "pattern": "^[a-z0-9_\\-]+,[a-z0-9_\\-]+$"
        },
        "role": {
          "enum": [
            "SEN",
            "SER",
            "DES"
          ]
        },
        "i2c_addr": {
          "$ref": "#/$defs/int"
        },
        "provenance": {
          "type": "string"
        },
        "chromacity": {
          "enum": [
            "color",
            "mono"
          ],
          "description": "The part variant's colour filter: colour (Bayer) or monochrome; the readout registers that differ per variant follow it. Colour when absent."
        },
        "device_id_reg": {
          "$ref": "#/$defs/int"
        },
        "device_id": {
          "$ref": "#/$defs/int"
        },
        "device_id_width": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2,
          "description": "Bytes of the identity register (MSB first); 1 when absent."
        },
        "kind": {
          "enum": [
            "cam"
          ],
          "description": "The personality kind these facts describe; cam when absent."
        },
        "chip": {
          "enum": [
            "generic",
            "sony_imx",
            "native"
          ],
          "description": "The law family (its <family>/ directory beside the cam personalities) whose laws and knobs this sensor's facts bind: generic for a table-only part, sony_imx for the FRAMOS register vocabulary, native for a head that programs its own sensor and serves the camera map alone, the smart camera; generic when absent. The .py beside a sensor's facts is the behaviour class the unit runs, never a law module."
        },
        "reg_bits": {
          "enum": [
            8,
            16
          ],
          "default": 16,
          "description": "Register address width on the sensor's I2C bus; 16 when absent."
        },
        "val_bits": {
          "enum": [
            8,
            16
          ],
          "default": 8,
          "description": "Register value width on the sensor's I2C bus; 8 when absent."
        }
      }
    },
    "registers": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "addr"
        ],
        "properties": {
          "addr": {
            "$ref": "#/$defs/int"
          },
          "width": {
            "type": "integer",
            "minimum": 1,
            "maximum": 4
          },
          "order": {
            "enum": [
              "le",
              "be"
            ]
          }
        }
      }
    },
    "modes": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/mode"
      }
    },
    "catalog": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "width": {
            "type": "integer"
          },
          "height": {
            "type": "integer"
          },
          "note": {
            "type": "string"
          }
        }
      }
    },
    "limits": {
      "type": "object",
      "properties": {
        "gain_max": {
          "$ref": "#/$defs/int",
          "description": "The largest raw gain register value the gain knob accepts."
        },
        "exposure_min_us": {
          "type": "integer",
          "minimum": 0,
          "description": "A native head's shortest exposure, in microseconds; the camera map serves it in lines of the running mode."
        },
        "exposure_margin_us": {
          "type": "integer",
          "minimum": 0,
          "description": "A native head's margin between the exposure and the frame period, in microseconds."
        },
        "frame_period_max_us": {
          "type": "integer",
          "minimum": 1,
          "description": "A native head's longest frame period, in microseconds."
        },
        "gain_min_mdb": {
          "type": "integer",
          "minimum": 0,
          "description": "A native head's lowest gain, in millidecibels, a multiple of the camera map's 100 mdB unit."
        },
        "gain_max_mdb": {
          "type": "integer",
          "minimum": 0,
          "description": "A native head's highest gain, in millidecibels, a multiple of 100 mdB."
        },
        "gain_step_mdb": {
          "type": "integer",
          "minimum": 1,
          "description": "A native head's gain increment, in millidecibels, a multiple of 100 mdB."
        },
        "black_level": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "min",
            "max"
          ],
          "properties": {
            "min": {
              "type": "integer",
              "minimum": 0
            },
            "max": {
              "type": "integer",
              "minimum": 0
            }
          },
          "description": "A native head's black-level range, in DN at the mode's bit depth; absent, the head offers no black level."
        },
        "flips": {
          "type": "boolean",
          "description": "A native head offers the flips field of the camera map."
        },
        "temperature": {
          "type": "boolean",
          "description": "A native head paints its temperature in the camera map."
        },
        "stream_gate": {
          "type": "boolean",
          "description": "A native head gates its stream through the camera map; the host writes no sensor register for it."
        },
        "fast_trigger": {
          "type": "object",
          "description": "The fast-trigger timing chart: the data output delay t_TGDLY as a fixed time, whole lines and wait registers, and the wait registers that extend the pulse's exposure. The family's output delay, readout delay and trigger exposure laws read it; a datasheet without the chart declares none.",
          "additionalProperties": false,
          "required": [
            "output_delay_us",
            "output_delay_lines",
            "output_delay_regs"
          ],
          "properties": {
            "output_delay_us": {
              "type": "number",
              "minimum": 0
            },
            "output_delay_lines": {
              "type": "integer",
              "minimum": 0
            },
            "output_delay_regs": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "pattern": "^[A-Z][A-Z0-9_]*$"
              }
            },
            "exposure_regs": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[A-Z][A-Z0-9_]*$"
              }
            }
          }
        }
      }
    },
    "trigger": {
      "type": "object",
      "properties": {
        "timing": {
          "type": "object",
          "properties": {
            "pulse_width_is_exposure": {
              "type": "boolean",
              "description": "Whether the sensor integrates for the trigger pulse's low time under fast trigger, its shutter register inert. The IDENTITY record carries it; under frame sync the tool states the exposure as the pulse's low time and refuses one asked."
            }
          }
        }
      }
    },
    "sync": {
      "type": "object",
      "properties": {
        "takes_trigger": {
          "type": "boolean",
          "description": "Whether the sensor takes the hub's frame-sync pulse (the fsync overlay converts it); false or absent free-runs under a port trigger."
        },
        "text": {
          "type": "string",
          "description": "How the sensor syncs, or why it does not, for the sync plan."
        }
      }
    },
    "test_pattern": {
      "type": "object"
    },
    "program": {
      "type": "object",
      "description": "What the family's programs compose with: the settles (ms after the write) of each standby-wrapped program, the timing program's fixed writes, and the live-knob declarations. A program whose set is absent is not offered.",
      "additionalProperties": false,
      "properties": {
        "timing_start": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "standby_ms": {
              "type": "integer"
            },
            "repairs": {
              "type": "object",
              "description": "Register name -> value rewritten before the timing registers (idempotent repairs of init-blob values).",
              "additionalProperties": {
                "$ref": "#/$defs/int"
              }
            },
            "syncsel": {
              "type": "string",
              "description": "The sync.syncsel role the timing program asserts."
            },
            "release_ms": {
              "type": "integer"
            },
            "start_ms": {
              "type": "integer"
            }
          }
        },
        "trigger_switch": {
          "$ref": "#/$defs/sleep_set"
        },
        "fast_trigger": {
          "$ref": "#/$defs/sleep_set"
        },
        "sync_switch": {
          "$ref": "#/$defs/sleep_set"
        },
        "restart": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "standby_ms": {
              "type": "integer"
            },
            "stop_ms": {
              "type": "integer"
            },
            "release_ms": {
              "type": "integer"
            },
            "start_ms": {
              "type": "integer"
            }
          }
        },
        "start": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "release_ms": {
              "type": "integer"
            },
            "start_ms": {
              "type": "integer"
            }
          }
        },
        "stop_ms": {
          "type": "integer"
        },
        "hmax_live": {
          "type": "boolean",
          "description": "HMAX may be rewritten on a running sensor under REGHOLD (the hmax knob); absent, the line length is a mode fact."
        },
        "adbit": {
          "type": "object",
          "description": "ADBIT code per output bit depth (bit depth -> code) for the ADBIT_MONOSEL register; the timing program writes the mode's depth with meta.chromacity.",
          "additionalProperties": {
            "type": [
              "integer",
              "string"
            ]
          }
        },
        "init_inck_hz": {
          "type": "integer",
          "minimum": 1,
          "description": "The INCK the init table's clock-dependent rows are set for; a link declaring another inck_hz is refused."
        },
        "blklevel": {
          "type": "object",
          "description": "The black-level register value per output bit depth (bit depth -> value, the datasheet's recommended setting); the timing program writes the mode's depth's.",
          "additionalProperties": {
            "type": [
              "integer",
              "string"
            ]
          }
        },
        "alive_reg": {
          "type": "string",
          "description": "The register a table-only part answers on for the alive poll; meta.device_id_reg when absent."
        }
      }
    },
    "controls": {
      "type": "object",
      "description": "A table-only part's controls: direct register writes clamped to min..max, one knob each; gain carries num/den (register steps per dB) for the kernel table. The `standby` control is the stream gate the flows start and stop the stream with, and no knob; it states its `standby` and `streaming` values.",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "reg",
          "min",
          "max"
        ],
        "properties": {
          "reg": {
            "type": "string"
          },
          "min": {
            "$ref": "#/$defs/int"
          },
          "max": {
            "$ref": "#/$defs/int"
          },
          "num": {
            "$ref": "#/$defs/int"
          },
          "den": {
            "$ref": "#/$defs/int"
          }
        }
      },
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_]*$"
      },
      "properties": {
        "standby": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "max",
            "min",
            "reg",
            "standby",
            "streaming"
          ],
          "properties": {
            "reg": {
              "type": "string"
            },
            "min": {
              "$ref": "#/$defs/int"
            },
            "max": {
              "$ref": "#/$defs/int"
            },
            "num": {
              "$ref": "#/$defs/int"
            },
            "den": {
              "$ref": "#/$defs/int"
            },
            "standby": {
              "$ref": "#/$defs/int",
              "description": "The stream gate's register value with the stream stopped."
            },
            "streaming": {
              "$ref": "#/$defs/int",
              "description": "The stream gate's register value with the stream running."
            }
          },
          "description": "The stream gate: the `standby` control states the register's value in standby and its value while streaming, and the flows start and stop the stream with it."
        }
      }
    },
    "status": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/probe"
      }
    },
    "runtime_forbidden": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/int"
      }
    },
    "outputs": {
      "type": "object",
      "description": "A deserializer's CSI-2 outputs by port name, one controller's port each: its MIPI_TX block, its controller number, its code in a map's MAP_DPHY_DEST field and in the PHY copy, its bit in the controllers' reset register, its rate register and PLL, and the controller's registers there.",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "block",
          "controller",
          "dphy",
          "reset_bit",
          "clock",
          "pll",
          "deskew",
          "lanes",
          "alt_mem_map",
          "tunnel"
        ],
        "properties": {
          "block": {
            "$ref": "#/$defs/int"
          },
          "controller": {
            "type": "integer"
          },
          "dphy": {
            "type": "integer"
          },
          "reset_bit": {
            "type": "integer"
          },
          "clock": {
            "type": "string"
          },
          "pll": {
            "type": "string"
          },
          "deskew": {
            "type": "string"
          },
          "lanes": {
            "type": "string"
          },
          "alt_mem_map": {
            "type": "string"
          },
          "tunnel": {
            "type": "string"
          }
        }
      }
    },
    "bank_blob_lanes": {
      "type": "integer",
      "description": "Port A's lane count the captured bank blob carries; a port with another count corrects it after the blob."
    },
    "windows": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/int"
      }
    },
    "pipes": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "arm",
          "vlock",
          "block",
          "map_en",
          "maps",
          "dest_0_3",
          "dest_4_7"
        ],
        "properties": {
          "arm": {
            "type": "string"
          },
          "vlock": {
            "type": "string"
          },
          "block": {
            "$ref": "#/$defs/int",
            "description": "The MIPI_TX block that holds the pipe's maps."
          },
          "map_en": {
            "type": "string"
          },
          "maps": {
            "type": "string",
            "description": "MAP_SRC_0, the first of the source and destination pairs."
          },
          "dest_0_3": {
            "type": "string"
          },
          "dest_4_7": {
            "type": "string"
          }
        }
      }
    },
    "capture": {
      "type": "object",
      "description": "The host capture table this sensor contributes (one capture-side mode per table entry, in order) and the per-sensor capture facts.",
      "additionalProperties": false,
      "required": [
        "mclk_khz",
        "pix_clk_hz",
        "gain",
        "hdr_ratio",
        "exposure",
        "framerate",
        "table"
      ],
      "properties": {
        "mclk_khz": {
          "type": "integer"
        },
        "pix_clk_hz": {
          "type": "integer"
        },
        "lane_polarity": {
          "type": "integer"
        },
        "tuning": {
          "type": "object",
          "description": "The vendor's ISP override the host folds into the capture stack's tuning for this sensor's modes: where it is published and its digest.",
          "additionalProperties": false,
          "required": ["override_url", "sha256"],
          "properties": {
            "override_url": {"type": "string", "format": "uri"},
            "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
          }
        },
        "clock_noncontinuous": {
          "type": "boolean",
          "description": "The sensor gates its clock lane between bursts, the fact the `clock-noncontinuous` endpoint property states in the Linux video-interfaces binding. Continuous when absent."
        },
        "gain": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "factor",
            "min",
            "max",
            "step",
            "default"
          ],
          "properties": {
            "factor": {
              "type": "integer"
            },
            "min": {
              "type": "integer"
            },
            "max": {
              "type": "integer"
            },
            "step": {
              "type": "integer"
            },
            "default": {
              "type": "integer"
            }
          }
        },
        "hdr_ratio": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "min",
            "max"
          ],
          "properties": {
            "min": {
              "type": "integer"
            },
            "max": {
              "type": "integer"
            }
          }
        },
        "exposure": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "factor",
            "max_us",
            "step",
            "default_us"
          ],
          "properties": {
            "factor": {
              "type": "integer"
            },
            "max_us": {
              "type": "integer"
            },
            "step": {
              "type": "integer"
            },
            "default_us": {
              "type": "integer"
            }
          }
        },
        "framerate": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "factor",
            "min_fps",
            "step"
          ],
          "properties": {
            "factor": {
              "type": "integer"
            },
            "min_fps": {
              "type": "number"
            },
            "step": {
              "type": "integer"
            }
          }
        },
        "table": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "width",
              "height",
              "bit_depth",
              "pixel_phase",
              "min_exp_us"
            ],
            "description": "One capture-side mode. A row that states no line length or top rate takes them from the unit-program mode of its geometry and depth (the line length from the mode's HMAX in the table's pixel clock, the top rate from the laws' datasheet frame at that line); a stated value stands.",
            "properties": {
              "width": {
                "type": "integer"
              },
              "height": {
                "type": "integer"
              },
              "bit_depth": {
                "type": "integer",
                "enum": [
                  8,
                  10,
                  12,
                  14,
                  16
                ]
              },
              "pixel_phase": {
                "type": "string",
                "enum": [
                  "rggb",
                  "grbg",
                  "gbrg",
                  "bggr"
                ]
              },
              "line_length": {
                "type": "integer",
                "description": "Pixel clocks per line; absent, the unit-program mode's HMAX in the table's pixel clock."
              },
              "max_fps": {
                "type": "number",
                "description": "The top rate; absent, the unit-program mode's datasheet frame at its line."
              },
              "min_exp_us": {
                "type": "integer"
              },
              "embedded_lines": {
                "type": "integer",
                "minimum": 0,
                "description": "Embedded-data lines the sensor emits with each frame of this row; the overlay declares them on a connector port and none behind the Hub, which parks them. Absent: none."
              }
            }
          }
        }
      }
    },
    "limits_source": {
      "type": "object",
      "description": "Where each limit came from: datasheet, driver (where the vendor driver is the only public source), or experimental (measured, experimental overlay only).",
      "additionalProperties": {
        "enum": [
          "datasheet",
          "driver",
          "experimental"
        ]
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "meta": {
            "properties": {
              "role": {
                "const": "SEN"
              }
            }
          }
        }
      },
      "then": {
        "required": [
          "default_mode",
          "modes"
        ]
      }
    }
  ],
  "$defs": {
    "int": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "string",
          "pattern": "^[+-]?(0[xX][0-9a-fA-F]+|0[oO][0-7]+|0[bB][01]+|[0-9]+)$"
        }
      ]
    },
    "sleep_set": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "standby_ms": {
          "type": "integer"
        },
        "release_ms": {
          "type": "integer"
        },
        "start_ms": {
          "type": "integer"
        }
      }
    },
    "mode": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "geometry",
        "mipi"
      ],
      "properties": {
        "geometry": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "width",
            "height",
            "bit_depth",
            "lanes",
            "rate_mbps"
          ],
          "properties": {
            "width": {
              "type": "integer",
              "minimum": 1
            },
            "height": {
              "type": "integer",
              "minimum": 1
            },
            "bit_depth": {
              "type": "integer",
              "minimum": 8,
              "maximum": 16
            },
            "lanes": {
              "type": "integer",
              "minimum": 1,
              "maximum": 4
            },
            "rate_mbps": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "timing": {
          "type": "object",
          "properties": {
            "line_time_ns": {
              "type": "integer",
              "minimum": 1,
              "description": "A native head's line period in this mode, in nanoseconds: the increment of its exposure and its frame period."
            },
            "frame_period_min_us": {
              "type": "integer",
              "minimum": 1,
              "description": "A native head's shortest frame period in this mode, in microseconds."
            },
            "waits": {
              "type": "object",
              "description": "The mode's own wait registers from its register list, where they differ from the sensor-wide captured set; the output delay reads them.",
              "minProperties": 1,
              "propertyNames": {
                "pattern": "^[A-Z][A-Z0-9_]*$"
              },
              "additionalProperties": {
                "$ref": "#/$defs/int"
              }
            }
          }
        },
        "sony": {
          "type": "object",
          "description": "The mode's row of the sensor datasheet's register lists: the recommended frame length V_TR (VMAX) the imaging characteristics are guaranteed at, the line length (HMAX), the frame rate at them, and the section that states them. The frame laws read V_TR from it; without it they compute the frame from `timing`.",
          "additionalProperties": false,
          "required": [
            "vmax",
            "hmax",
            "section"
          ],
          "properties": {
            "vmax": {
              "type": "integer",
              "minimum": 1
            },
            "hmax": {
              "type": "integer",
              "minimum": 1
            },
            "max_fps": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "section": {
              "type": "string",
              "pattern": "^[0-9]+(\\.[0-9]+)*$"
            }
          }
        },
        "mipi": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "data_type"
          ],
          "properties": {
            "data_type": {
              "type": "string",
              "pattern": "^RAW(8|10|12|14|16)$"
            },
            "trigger_input": {
              "type": "string"
            },
            "embedded_lines": {
              "type": "integer",
              "minimum": 0,
              "description": "Embedded-data lines the sensor emits with each frame of this mode, the count its capture row carries."
            }
          }
        },
        "sensor_mode": {
          "description": "Ignored: the host derives a mode's capture index from the table it generates. Accepted so a sealed personality that carries it still reads.",
          "type": "integer",
          "minimum": 0
        },
        "blobs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "final_blob": {
          "type": "string"
        },
        "solo_blob": {
          "type": "string",
          "description": "The captured full-chain program the mode's unit program is pinned against (one blob per link)."
        },
        "final_blob_primary": {
          "type": "string",
          "description": "The final blob variant the captured dual program uses on its primary link."
        },
        "host_only": {
          "type": "boolean",
          "description": "The unit program does not offer this mode: the host tool judges it by its laws only. Set for a mode a captured whole-chain program serves until that capture is split into unit programs, and for a mode without a program yet."
        },
        "serializer_csi": {
          "type": "boolean",
          "description": "The personality writes the serializer's CSI block for this mode after its tables; the host composes none."
        },
        "table": {
          "type": "string",
          "description": "The register table (beside the facts file) the unit program writes after the shared init for this mode; the behaviour class loads it by this name."
        }
      }
    },
    "probe": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "reg"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
        },
        "reg": {
          "type": "string"
        },
        "decode": {
          "type": "object"
        },
        "format": {
          "enum": [
            "int",
            "hex"
          ]
        },
        "desc": {
          "type": "string"
        },
        "expect": {
          "$ref": "#/$defs/int"
        },
        "mask": {
          "$ref": "#/$defs/int"
        },
        "warn_nonzero": {
          "type": "boolean"
        }
      }
    }
  }
}
