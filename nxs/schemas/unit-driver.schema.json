{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aliensense.github.io/nxs-docs/schemas/unit-driver.schema.json",
  "title": "NXS unit driver descriptor (<driver>.yaml)",
  "description": "The fact sheet beside a unit sensor driver: the parameters it offers, as the options an operator may pick. Entry order fixes the wire's parameter indices, so entries never reorder. Values and defaults are int32 — the descriptor wire carries nothing else — so a fractional physical value is encoded in a smaller integer unit (mHz, mV).",
  "type": "object",
  "additionalProperties": false,
  "required": ["meta", "params"],
  "properties": {
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["driver"],
      "properties": {
        "driver": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"},
        "bus": {"type": "string"},
        "brief": {"type": "string"},
        "kind": {"enum": ["unit"], "description": "The personality kind this descriptor is; unit when absent."}
      }
    },
    "params": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "values", "default"],
        "properties": {
          "name": {"type": "string", "pattern": "^[a-z_][a-z0-9_]*$"},
          "values": {
            "type": "array",
            "minItems": 1,
            "items": {"$ref": "#/$defs/int32"}
          },
          "default": {"$ref": "#/$defs/int32"},
          "unit": {"type": "string"},
          "type": {"enum": ["enum", "range"]},
          "kind": {"enum": ["reload", "live"]}
        },
        "if": {"properties": {"type": {"const": "range"}}, "required": ["type"]},
        "then": {"properties": {"values": {"minItems": 2, "maxItems": 2},
                                "kind": {"const": "live"}}}
      }
    }
  },
  "$defs": {
    "int32": {"type": "integer", "minimum": -2147483648, "maximum": 2147483647}
  }
}
